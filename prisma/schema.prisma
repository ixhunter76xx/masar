// مخطط قاعدة بيانات منصة مركز حساب
// المرحلة الحالية: المستخدمون والأدوار، الفصول الدراسية، المقررات، التسجيل.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

// في Prisma 7 لم يعد `url` مسموحًا هنا — انتقل إلى prisma.config.ts
datasource db {
  provider = "postgresql"
}

/// أدوار المنصة الثلاثة
enum Role {
  STUDENT /// طالب
  INSTRUCTOR /// مدرب
  ADMIN /// إدارة
}

model User {
  id String @id @default(cuid())

  /// اسم الدخول: الرقم الأكاديمي أو البريد المؤسسي
  username String  @unique
  email    String? @unique
  name     String

  /// تجزئة bcrypt — لا تُخزَّن كلمة المرور الأصلية إطلاقًا
  passwordHash String

  role     Role    @default(STUDENT)
  isActive Boolean @default(true)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// المقررات التي يُدرّسها (للمدرب)
  coursesTaught Course[] @relation("CourseInstructor")

  /// المقررات المسجَّل بها (للطالب)
  enrollments Enrollment[]

  /// المواد التي رفعها
  uploadedMaterials CourseMaterial[] @relation("MaterialUploader")

  /// الإعلانات التي نشرها
  authoredAnnouncements Announcement[] @relation("AnnouncementAuthor")

  /// الإعلانات التي قرأها
  announcementReads AnnouncementRead[]

  /// الاختبارات التي أنشأها
  authoredQuizzes Quiz[] @relation("QuizAuthor")

  /// محاولاته في الاختبارات
  quizAttempts QuizAttempt[]

  /// الواجبات التي أنشأها
  authoredAssignments Assignment[] @relation("AssignmentAuthor")

  /// تسليماته للواجبات
  submissions Submission[] @relation("SubmissionStudent")

  /// التسليمات التي صحّحها
  gradedSubmissions Submission[] @relation("SubmissionGrader")

  @@index([role])
  @@map("users")
}

/// حالة الفصل الدراسي
enum TermStatus {
  ACTIVE /// نشط — الفصل الجاري
  ARCHIVED /// مؤرشف — فصل منتهٍ
}

/// الفصل الدراسي — كيان مستقل يسمح بتنظيم المقررات وأرشفة المنتهية منها
model Term {
  id String @id @default(cuid())

  /// مثال: "2025/2026 — الفصل الثاني"
  name String @unique

  startsOn DateTime   @db.Date
  endsOn   DateTime   @db.Date
  status   TermStatus @default(ACTIVE)

  courses Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startsOn])
  @@map("terms")
}

model Course {
  id String @id @default(cuid())

  /// رمز المقرر، مثال: "MATH101"
  code        String
  title       String
  description String?

  /// كل مقرر يخصّ فصلًا دراسيًا واحدًا — لا نص حر
  termId String
  term   Term   @relation(fields: [termId], references: [id], onDelete: Restrict)

  instructorId String
  instructor   User   @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: Restrict)

  enrollments   Enrollment[]
  materials     CourseMaterial[]
  announcements Announcement[]
  quizzes       Quiz[]
  assignments   Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// الرمز نفسه قد يتكرر عبر الفصول، لكنه فريد داخل الفصل الواحد
  @@unique([termId, code])
  @@index([instructorId])
  @@map("courses")
}

/// حالة تسجيل الطالب في المقرر
enum EnrollmentStatus {
  ACTIVE /// مسجَّل ومتابع
  COMPLETED /// أنهى المقرر
  DROPPED /// انسحب
}

model Enrollment {
  id String @id @default(cuid())

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())

  /// لا يُسجَّل الطالب في المقرر نفسه مرتين
  @@unique([studentId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

/// نوع المادة التعليمية — يبدأ بالفيديو ويتوسّع لاحقًا
enum MaterialKind {
  VIDEO /// محاضرة مسجّلة
}

/// حالة المادة في دورة حياة الرفع
enum MaterialStatus {
  PENDING /// أُنشئ السجل والرفع جارٍ أو لم يكتمل
  READY /// اكتمل الرفع وتحقّق الخادم من الملف
  FAILED /// فشل الرفع أو رُفض الملف بعد التحقق
}

/// مادة تعليمية داخل مقرر — حاليًا فيديو مخزَّن على Cloudflare R2
model CourseMaterial {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  kind   MaterialKind   @default(VIDEO)
  status MaterialStatus @default(PENDING)

  title       String
  description String?

  /// مفتاح الكائن داخل دلو R2
  objectKey   String  @unique
  contentType String  @default("video/mp4")

  /// الحجم الفعلي بعد التحقق من R2 — BigInt استعدادًا لملفات أكبر لاحقًا
  sizeBytes   BigInt?
  durationSec Int?

  uploadedById String
  uploadedBy   User   @relation("MaterialUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  /// ترتيب العرض داخل المقرر
  position Int @default(0)

  /// null يعني مسودة لا يراها الطلاب
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, position])
  @@index([courseId, status])
  @@map("course_materials")
}

/// إعلان على مستوى المقرر
model Announcement {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title String
  body  String

  authorId String
  author   User   @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  /// null يعني مسودة لا يراها الطلاب
  publishedAt DateTime?

  /// يُثبّت الإعلان أعلى القائمة
  isPinned Boolean @default(false)

  reads AnnouncementRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, publishedAt])
  @@map("announcements")
}

/// سجل قراءة إعلان — أساس عدّاد "غير المقروء"
model AnnouncementRead {
  id String @id @default(cuid())

  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  /// قراءة واحدة لكل مستخدم لكل إعلان
  @@unique([announcementId, userId])
  @@index([userId])
  @@map("announcement_reads")
}

/// حالة الاختبار
enum QuizStatus {
  DRAFT /// مسودة — المدرب وحده يراها
  PUBLISHED /// متاح للطلاب
  CLOSED /// مغلق — لا تُقبل محاولات جديدة
}

/// نوع السؤال — موضوعي فقط في هذه المرحلة (تصحيح آلي كامل)
enum QuestionKind {
  MULTIPLE_CHOICE /// اختيار من متعدد
  TRUE_FALSE /// صح أو خطأ
}

model Quiz {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      QuizStatus @default(DRAFT)

  /// عدد المحاولات المسموح بها. الدرجة المعتمدة هي **أعلى** محاولة.
  maxAttempts Int @default(1)

  /// مدة الاختبار بالدقائق — null يعني بلا حد
  timeLimitMin Int?

  /// نافذة الإتاحة — null يعني بلا قيد
  opensAt  DateTime?
  closesAt DateTime?

  /// ترتيب عشوائي للأسئلة عند كل محاولة
  shuffleQuestions Boolean @default(false)

  authorId String
  author   User   @relation("QuizAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  questions Question[]
  attempts  QuizAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, status])
  @@map("quizzes")
}

model Question {
  id String @id @default(cuid())

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  kind QuestionKind @default(MULTIPLE_CHOICE)
  text String

  /// درجة السؤال
  points Int @default(1)

  position Int @default(0)

  options QuestionOption[]
  answers Answer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quizId, position])
  @@map("questions")
}

/// خيار إجابة. صح/خطأ يُمثَّل بخيارين، فيتوحّد منطق التصحيح.
model QuestionOption {
  id String @id @default(cuid())

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  text      String
  isCorrect Boolean @default(false)
  position  Int     @default(0)

  answers Answer[]

  @@index([questionId, position])
  @@map("question_options")
}

model QuizAttempt {
  id String @id @default(cuid())

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// رقم المحاولة لهذا الطالب في هذا الاختبار، يبدأ من ١
  attemptNumber Int

  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  /// تُحسب عند التسليم
  earnedPoints Int?
  totalPoints  Int?

  answers Answer[]

  /// لا تتكرر المحاولة نفسها لنفس الطالب
  @@unique([quizId, studentId, attemptNumber])
  @@index([studentId])
  @@map("quiz_attempts")
}

model Answer {
  id String @id @default(cuid())

  attemptId String
  attempt   QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOptionId String?
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  /// نتيجة التصحيح الآلي وقت التسليم
  isCorrect    Boolean?
  earnedPoints Int?

  /// إجابة واحدة لكل سؤال في المحاولة الواحدة
  @@unique([attemptId, questionId])
  @@map("answers")
}

/// حالة الواجب
enum AssignmentStatus {
  DRAFT /// مسودة — المدرب وحده يراها
  PUBLISHED /// متاح للطلاب
  CLOSED /// مغلق — لا تُقبل تسليمات جديدة
}

/// حالة التسليم
enum SubmissionStatus {
  SUBMITTED /// سُلِّم وينتظر التصحيح
  GRADED /// صُحِّح واعتُمدت درجته
}

model Assignment {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      AssignmentStatus @default(DRAFT)

  /// الدرجة الكاملة — يقابل QuizAttempt.totalPoints في دفتر الدرجات
  totalPoints Int @default(10)

  dueAt DateTime?

  /// سياسة التأخير
  allowLate          Boolean @default(false)
  /// نسبة الخصم من الدرجة عند التسليم المتأخر (٠ = بلا خصم)
  latePenaltyPercent Int     @default(0)

  /// الامتدادات المسموحة بلا نقطة، مثل ["pdf","docx"]
  allowedExtensions String[] @default(["pdf", "docx", "zip", "png", "jpg"])
  /// الحد الأقصى لحجم الملف بالميجابايت
  maxFileMb         Int      @default(20)

  authorId String
  author   User   @relation("AssignmentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, status])
  @@map("assignments")
}

/// تسليم طالب لواجب.
/// يتبع نمط QuizAttempt عمدًا (earnedPoints/totalPoints/gradedAt)
/// ليدمجهما دفتر الدرجات لاحقًا بلا تحويل.
model Submission {
  id String @id @default(cuid())

  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("SubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)

  /// ملاحظة نصية اختيارية من الطالب
  note String?

  /// الملف على R2 — قد يكون التسليم ملاحظة بلا ملف
  objectKey     String?
  fileName      String?
  fileSizeBytes BigInt?
  contentType   String?

  submittedAt DateTime @default(now())
  isLate      Boolean  @default(false)

  status SubmissionStatus @default(SUBMITTED)

  /// الدرجة كما أدخلها المدرب قبل أي خصم
  rawPoints Int?
  /// الدرجة النهائية بعد خصم التأخير — هذه ما يقرأه دفتر الدرجات
  earnedPoints Int?

  feedback   String?
  gradedAt   DateTime?
  gradedById String?
  gradedBy   User?     @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  /// تسليم واحد لكل طالب لكل واجب — يُستبدل عند إعادة التسليم
  @@unique([assignmentId, studentId])
  @@index([assignmentId, status])
  @@map("submissions")
}
