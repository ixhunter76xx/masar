// مخطط قاعدة بيانات منصة مركز حساب
// المرحلة الحالية: المستخدمون والأدوار، الفصول الدراسية، المقررات، التسجيل.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

// في Prisma 7 لم يعد `url` مسموحًا هنا — انتقل إلى prisma.config.ts
datasource db {
  provider = "postgresql"
}

/// أدوار المنصة الثلاثة
enum Role {
  STUDENT /// طالب
  INSTRUCTOR /// مدرب
  ADMIN /// إدارة
}

model User {
  id String @id @default(cuid())

  /// اسم الدخول: الرقم الأكاديمي أو البريد المؤسسي
  username String  @unique
  email    String? @unique
  name     String

  /// تجزئة bcrypt — لا تُخزَّن كلمة المرور الأصلية إطلاقًا
  passwordHash String

  role     Role    @default(STUDENT)
  isActive Boolean @default(true)

  /// يُجبَر المستخدم على تغيير كلمة مروره قبل استخدام المنصة.
  /// يُفعَّل عند إنشاء الحساب وعند إعادة تعيين كلمة المرور من الإدارة.
  mustChangePassword Boolean @default(true)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// المقررات التي يُدرّسها (للمدرب)
  coursesPresented Course[] @relation("CoursePresenter")

  /// المقررات المسجَّل بها (للطالب)
  enrollments Enrollment[]

  /// المواد التي رفعها
  uploadedMaterials CourseMaterial[] @relation("MaterialUploader")

  /// الإعلانات التي نشرها
  authoredAnnouncements Announcement[] @relation("AnnouncementAuthor")

  /// الإعلانات التي قرأها
  announcementReads AnnouncementRead[]

  /// الاختبارات التي أنشأها
  authoredQuizzes Quiz[] @relation("QuizAuthor")

  /// محاولاته في الاختبارات
  quizAttempts QuizAttempt[]

  /// الواجبات التي أنشأها
  authoredAssignments Assignment[] @relation("AssignmentAuthor")

  /// تسليماته للواجبات
  submissions Submission[] @relation("SubmissionStudent")

  /// التسليمات التي صحّحها
  gradedSubmissions Submission[] @relation("SubmissionGrader")

  /// طلبات الشراء وتقدّم المشاهدة
  orders         Order[]
  lessonProgress LessonProgress[]

  /// محادثاته كطالب — للمدرب تُشتق من مقرراته لا من هنا
  conversations Conversation[] @relation("ConversationStudent")

  /// الرسائل التي أرسلها في أي محادثة
  sentMessages Message[] @relation("MessageSender")

  @@index([role])
  @@map("users")
}



model Course {
  id String @id @default(cuid())

  /// رمز المقرر الجامعي — ARAB110
  code String @unique
  /// المسار العام: /courses/arab110
  slug String @unique

  title String
  /// نبذة قصيرة تظهر في بطاقة الكتالوج
  summary     String?
  description String?
  /// مفتاح صورة الغلاف في R2
  coverKey String?

  /// لا يظهر في الكتالوج العام قبل نشره
  isPublished Boolean @default(false)
  sortOrder   Int     @default(0)

  /// الأستاذ المقدّم — للعرض فقط.
  ///
  /// في مسار لا يدير الأستاذ المقرر ولا يسعّره؛ دوره إنتاج المحتوى.
  /// لذلك الحقل اختياري، والصلاحية الوحيدة المبنية عليه هي معاينة
  /// محتوى مقرراته قبل نشره — لا إدارة ولا وصول لبيانات الطلاب.
  presenterId String?
  presenter   User?   @relation("CoursePresenter", fields: [presenterId], references: [id], onDelete: SetNull)

  products      Product[]
  materials     CourseMaterial[]
  announcements Announcement[]
  quizzes       Quiz[]
  assignments   Assignment[]
  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, sortOrder])
  @@index([presenterId])
  @@map("courses")
}



/// نوع المادة التعليمية — يبدأ بالفيديو ويتوسّع لاحقًا
enum MaterialKind {
  VIDEO /// محاضرة مسجّلة
}

/// حالة المادة في دورة حياة الرفع
enum MaterialStatus {
  PENDING /// أُنشئ السجل والرفع جارٍ أو لم يكتمل
  READY /// اكتمل الرفع وتحقّق الخادم من الملف
  FAILED /// فشل الرفع أو رُفض الملف بعد التحقق
}

/// مادة تعليمية داخل مقرر — حاليًا فيديو مخزَّن على Cloudflare R2
model CourseMaterial {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  kind   MaterialKind   @default(VIDEO)
  status MaterialStatus @default(PENDING)

  title       String
  description String?

  /// مفتاح الكائن داخل دلو R2
  objectKey   String  @unique
  contentType String  @default("video/mp4")

  /// الحجم الفعلي بعد التحقق من R2 — BigInt استعدادًا لملفات أكبر لاحقًا
  sizeBytes   BigInt?
  durationSec Int?

  uploadedById String
  uploadedBy   User   @relation("MaterialUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  /// ترتيب العرض داخل المقرر
  position Int @default(0)

  /// الدرس المجاني على الصفحة العامة — يراه الزائر قبل الشراء.
  /// يُبثّ برابط موقّع كغيره، لكن بلا فحص حقّ وصول.
  isFreePreview Boolean @default(false)

  /// null يعني مسودة لا يراها الطلاب
  publishedAt DateTime?

  productItems ProductItem[]
  progress     LessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, position])
  @@index([courseId, status])
  @@map("course_materials")
}

/// إعلان على مستوى المقرر
model Announcement {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title String
  body  String

  authorId String
  author   User   @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  /// null يعني مسودة لا يراها الطلاب
  publishedAt DateTime?

  /// يُثبّت الإعلان أعلى القائمة
  isPinned Boolean @default(false)

  reads AnnouncementRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, publishedAt])
  @@map("announcements")
}

/// سجل قراءة إعلان — أساس عدّاد "غير المقروء"
model AnnouncementRead {
  id String @id @default(cuid())

  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  /// قراءة واحدة لكل مستخدم لكل إعلان
  @@unique([announcementId, userId])
  @@index([userId])
  @@map("announcement_reads")
}

/// حالة الاختبار
enum QuizStatus {
  DRAFT /// مسودة — المدرب وحده يراها
  PUBLISHED /// متاح للطلاب
  CLOSED /// مغلق — لا تُقبل محاولات جديدة
}

/// نوع السؤال — موضوعي فقط في هذه المرحلة (تصحيح آلي كامل)
enum QuestionKind {
  MULTIPLE_CHOICE /// اختيار من متعدد
  TRUE_FALSE /// صح أو خطأ
}

model Quiz {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      QuizStatus @default(DRAFT)

  /// عدد المحاولات المسموح بها. الدرجة المعتمدة هي **أعلى** محاولة.
  maxAttempts Int @default(1)

  /// مدة الاختبار بالدقائق — null يعني بلا حد
  timeLimitMin Int?

  /// نافذة الإتاحة — null يعني بلا قيد
  opensAt  DateTime?
  closesAt DateTime?

  /// ترتيب عشوائي للأسئلة عند كل محاولة
  shuffleQuestions Boolean @default(false)

  authorId String
  author   User   @relation("QuizAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  questions Question[]
  attempts  QuizAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productItems ProductItem[]

  @@index([courseId, status])
  @@map("quizzes")
}

model Question {
  id String @id @default(cuid())

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  kind QuestionKind @default(MULTIPLE_CHOICE)
  text String

  /// درجة السؤال
  points Int @default(1)

  position Int @default(0)

  options QuestionOption[]
  answers Answer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quizId, position])
  @@map("questions")
}

/// خيار إجابة. صح/خطأ يُمثَّل بخيارين، فيتوحّد منطق التصحيح.
model QuestionOption {
  id String @id @default(cuid())

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  text      String
  isCorrect Boolean @default(false)
  position  Int     @default(0)

  answers Answer[]

  @@index([questionId, position])
  @@map("question_options")
}

model QuizAttempt {
  id String @id @default(cuid())

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// رقم المحاولة لهذا الطالب في هذا الاختبار، يبدأ من ١
  attemptNumber Int

  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  /// تُحسب عند التسليم
  earnedPoints Int?
  totalPoints  Int?

  answers Answer[]

  /// لا تتكرر المحاولة نفسها لنفس الطالب
  @@unique([quizId, studentId, attemptNumber])
  @@index([studentId])
  @@map("quiz_attempts")
}

model Answer {
  id String @id @default(cuid())

  attemptId String
  attempt   QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOptionId String?
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  /// نتيجة التصحيح الآلي وقت التسليم
  isCorrect    Boolean?
  earnedPoints Int?

  /// إجابة واحدة لكل سؤال في المحاولة الواحدة
  @@unique([attemptId, questionId])
  @@map("answers")
}

/// حالة الواجب
enum AssignmentStatus {
  DRAFT /// مسودة — المدرب وحده يراها
  PUBLISHED /// متاح للطلاب
  CLOSED /// مغلق — لا تُقبل تسليمات جديدة
}

/// حالة التسليم
enum SubmissionStatus {
  SUBMITTED /// سُلِّم وينتظر التصحيح
  GRADED /// صُحِّح واعتُمدت درجته
}

model Assignment {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      AssignmentStatus @default(DRAFT)

  /// الدرجة الكاملة — يقابل QuizAttempt.totalPoints في دفتر الدرجات
  totalPoints Int @default(10)

  dueAt DateTime?

  /// سياسة التأخير
  allowLate          Boolean @default(false)
  /// نسبة الخصم من الدرجة عند التسليم المتأخر (٠ = بلا خصم)
  latePenaltyPercent Int     @default(0)

  /// الامتدادات المسموحة بلا نقطة، مثل ["pdf","docx"]
  allowedExtensions String[] @default(["pdf", "docx", "zip", "png", "jpg"])
  /// الحد الأقصى لحجم الملف بالميجابايت
  maxFileMb         Int      @default(20)

  authorId String
  author   User   @relation("AssignmentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, status])
  @@map("assignments")
}

/// تسليم طالب لواجب.
/// يتبع نمط QuizAttempt عمدًا (earnedPoints/totalPoints/gradedAt)
/// ليدمجهما دفتر الدرجات لاحقًا بلا تحويل.
model Submission {
  id String @id @default(cuid())

  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("SubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)

  /// ملاحظة نصية اختيارية من الطالب
  note String?

  /// الملف على R2 — قد يكون التسليم ملاحظة بلا ملف
  objectKey     String?
  fileName      String?
  fileSizeBytes BigInt?
  contentType   String?

  submittedAt DateTime @default(now())
  isLate      Boolean  @default(false)

  status SubmissionStatus @default(SUBMITTED)

  /// الدرجة كما أدخلها المدرب قبل أي خصم
  rawPoints Int?
  /// الدرجة النهائية بعد خصم التأخير — هذه ما يقرأه دفتر الدرجات
  earnedPoints Int?

  feedback   String?
  gradedAt   DateTime?
  gradedById String?
  gradedBy   User?     @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  /// تسليم واحد لكل طالب لكل واجب — يُستبدل عند إعادة التسليم
  @@unique([assignmentId, studentId])
  @@index([assignmentId, status])
  @@map("submissions")
}

/// محادثة ثنائية بين طالب ومدرب في سياق مقرر واحد.
///
/// ── لماذا لا يُخزَّن معرّف المدرب هنا ──────────────────────────────────
/// للمقرر مدرب واحد، فـ(المقرر + الطالب) يحدّدان الطرفين تمامًا. تخزين
/// `instructorId` كان سيسرّع استعلام صندوق وارد المدرب سطرًا واحدًا،
/// لكنه يخلق حقيقتين للمعلومة نفسها: لو نُقل المقرر إلى مدرب آخر لبقيت
/// المحادثات معلّقة بالمدرب القديم. الاشتقاق من `course.instructorId`
/// يبقى صحيحًا دائمًا، والحقل مفهرس أصلًا.
/// ──────────────────────────────────────────────────────────────────────
model Conversation {
  id        String @id @default(cuid())
  courseId  String
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId String
  student   User   @relation("ConversationStudent", fields: [studentId], references: [id], onDelete: Cascade)

  messages Message[]

  /// وقت آخر رسالة — للترتيب في صندوق الوارد بلا تجميع مكلف
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  /// محادثة واحدة لكل طالب في كل مقرر — لا تتفرّع الخيوط
  @@unique([courseId, studentId])
  @@index([courseId, lastMessageAt])
  @@index([studentId, lastMessageAt])
  @@map("conversations")
}

/// رسالة واحدة داخل محادثة.
///
/// ── تتبّع القراءة: لماذا حقل لا جدول وصل ─────────────────────────────
/// الإعلان يقرؤه كثيرون، فاحتاج `AnnouncementRead` صفًّا لكل قارئ.
/// أما الرسالة هنا فلها **مستلم واحد بالتعريف** — الطرف الآخر في محادثة
/// ثنائية. جدول وصل كان سينتج صفًّا واحدًا لكل رسالة دائمًا: نفس
/// المعلومة بجدول إضافي وضمّ إضافي في كل عدّ.
///
/// المبدأ المشترك مع الإعلانات محفوظ: حالة القراءة مخزّنة صراحةً على
/// الخادم، والعدّاد يُحسب منها لا من تخمين في الواجهة.
/// ──────────────────────────────────────────────────────────────────────
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// المرسل — والمستلم هو الطرف الآخر ضمنًا
  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  body String

  /// متى قرأها المستلم. فارغ = غير مقروءة.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([conversationId, createdAt])
  /// يخدم عدّ غير المقروء: تصفية على القارئ ثم على الحالة
  @@index([senderId, readAt])
  @@map("messages")
}

/// ═══════════════════════════════════════════════════════════════════
///  طبقة المنتج والشراء
/// ═══════════════════════════════════════════════════════════════════

/// ما يُباع فعلًا: "دورة المنتصف"، "دورة النهائي"، "الدورة الكاملة".
///
/// المقرر وعاء أكاديمي لا يُشترى؛ المنتج هو وحدة البيع والوصول معًا.
model Product {
  id          String  @id @default(cuid())
  courseId    String
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  description String?

  /// السعر بالفلس لا بالدينار.
  ///
  /// الدينار البحريني ثلاث خانات عشرية (١ د.ب = ١٠٠٠ فلس)، وبوابات
  /// الدفع تستقبل المبلغ بأصغر وحدة. تخزينه عددًا صحيحًا يمنع أخطاء
  /// التقريب التي يجرّها العدد العشري في المال.
  priceFils Int
  currency  String @default("BHD")

  isPublished Boolean @default(false)
  sortOrder   Int     @default(0)

  items       ProductItem[]
  enrollments Enrollment[]
  orderItems  OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, slug])
  @@index([courseId, sortOrder])
  @@index([isPublished])
  @@map("products")
}

enum ProductItemKind {
  LESSON /// درس فيديو
  QUIZ   /// اختبار
}

/// منهج المنتج: قائمة مرتّبة تشير إلى دروس واختبارات المقرر.
///
/// ── لماذا إشارة لا ملكية ─────────────────────────────────────────────
/// المنتجات متداخلة بطبيعتها: "الدورة الكاملة" تضمّ ما في دورتَي
/// المنتصف والنهائي. لو ملك المنتجُ الدرسَ لوجب رفع الفيديو نفسه مرتين
/// أو ثلاثًا إلى R2 — تكلفة تخزين مضاعفة وتحديثٌ في ثلاثة مواضع.
///
/// ── ولماذا جدول واحد لا جدولا وصل ────────────────────────────────────
/// ترتيب المنهج يخلط الفيديو والاختبار، ويختلف من منتج لآخر. جدولان
/// منفصلان يفقدان الترتيب الموحّد ويحتاجان دمجًا في كل قراءة.
/// ─────────────────────────────────────────────────────────────────────
model ProductItem {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      ProductItemKind

  /// أحدهما بالضبط غير فارغ — يفرضه قيد CHECK في ملف الهجرة
  lessonId String?
  lesson   CourseMaterial? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quizId   String?
  quiz     Quiz?           @relation(fields: [quizId], references: [id], onDelete: Cascade)

  position Int @default(0)

  @@unique([productId, lessonId])
  @@unique([productId, quizId])
  @@index([productId, position])
  @@map("product_items")
}

enum GrantSource {
  PURCHASE    /// شراء مكتمل
  ADMIN_GRANT /// منحته الإدارة يدويًا
}

/// حق الوصول إلى منتج. الاسم موروث، والمعنى تغيّر من "تسجيل في مقرر"
/// إلى "امتلاك منتج".
model Enrollment {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  source    GrantSource @default(PURCHASE)

  /// الطلب الذي منح الوصول — فارغ في المنح الإداري
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  grantedAt DateTime  @default(now())
  /// فارغ = وصول دائم. الحقل موجود ليدعم اشتراكًا مؤقتًا لاحقًا بلا هجرة.
  expiresAt DateTime?

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("enrollments")
}

enum OrderStatus {
  PENDING   /// أُنشئ وينتظر الدفع
  PAID      /// اكتمل الدفع ومُنح الوصول
  FAILED    /// رفضته البوابة
  CANCELLED /// تركه المشتري
  REFUNDED  /// أُعيد المبلغ
}

model Order {
  id     String      @id @default(cuid())
  /// رقم مقروء للعميل والدعم — MSR-2026-0001
  number String      @unique
  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status OrderStatus @default(PENDING)

  totalFils Int
  currency  String @default("BHD")

  items       OrderItem[]
  payments    Payment[]
  enrollments Enrollment[]

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

/// سطر في الطلب — بلقطة من السعر والاسم وقت الشراء.
///
/// بلا اللقطة يتغيّر تاريخ المبيعات كلّه مع كل تعديل تسعير، ويرى العميل
/// في فاتورته القديمة سعرًا لم يدفعه.
model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Restrict لا Cascade: حذف منتج يجب ألّا يمحو سجلًّا ماليًا
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  unitPriceFils Int
  titleSnapshot String

  @@unique([orderId, productId])
  @@map("order_items")
}

/// محاولة دفع لدى البوابة.
///
/// `@@unique([provider, providerPaymentId])` ليس تحسينًا: البوابات تعيد
/// إرسال الـ webhook عند الشك في الوصول. بدون هذا القيد قد يُحتسب الدفع
/// مرتين ويُمنح الوصول مرتين.
model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider          String
  providerPaymentId String
  status            String
  amountFils        Int
  /// الحمولة الخام كما وصلت — مرجع النزاعات والتدقيق
  rawPayload Json?

  createdAt DateTime @default(now())

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@map("payments")
}

/// موضع المشاهدة الأخير — يستأنف الطالب من حيث توقّف.
model LessonProgress {
  id       String         @id @default(cuid())
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   CourseMaterial @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  positionSec Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId, updatedAt])
  @@map("lesson_progress")
}
