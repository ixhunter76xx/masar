# ═══════════════════════════════════════════════════════════════
#  انسخ هذا الملف إلى .env ثم عبّئ القيم
#  cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ١) قاعدة البيانات — رابطان لا رابط واحد
#
#    DATABASE_URL  = رابط الـ pooler، يستخدمه التطبيق وقت التشغيل.
#                    في Neon يحوي "-pooler" في اسم المضيف.
#    DIRECT_URL    = الرابط المباشر، تستخدمه الهجرات فقط.
#                    بلا "-pooler". إن تُرك فارغًا يُستخدم DATABASE_URL.
#
#    لماذا الفصل؟ كل نسخة خادمية تفتح اتصالًا؛ بلا pooler تُستنفد حصة
#    الاتصالات. والهجرات بالمقابل تحتاج جلسة مباشرة لأقفال DDL.
#
#    للتطوير المحلي بـ Docker يكفي رابط واحد في الاثنين.
DATABASE_URL=""
DIRECT_URL=""

#    حجم مجمّع الاتصالات لكل نسخة (اختياري، الافتراضي ٥).
#    في البيئات الخادمية اخفضه إلى ١–٣.
# DB_POOL_MAX="5"

# ٢) مفتاح توقيع الجلسات — ولّده بهذا الأمر والصق الناتج:
#    node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# ٣) تخزين الفيديو والمرفقات على Cloudflare R2
#
#    من لوحة Cloudflare ← R2 ← Manage API Tokens ← Create API Token
#    بصلاحية "Object Read & Write" على الدلو المطلوب.
#    هذه المتغيّرات يقرأها Next.js فقط، فيمكن وضعها في .env.local
#    (بينما DATABASE_URL يجب أن يبقى في .env لأن Prisma CLI لا يقرأ .env.local)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="hisab-media"
#    اختياري — تُبنى تلقائيًا من R2_ACCOUNT_ID إن تُركت فارغة
R2_ENDPOINT=""

# ٤) كلمتا مرور الحسابين المبذورين (اختياريتان)
#
#    يستخدمهما `prisma db seed` عند إنشاء admin@masar.bh و
#    ustath@masar.bh. إن تُركتا فارغتين تُولَّد كلمة مرور عشوائية
#    لكل حساب وتُطبع في الطرفية مرة واحدة وقت الإنشاء فقط —
#    لا قيمة افتراضية معروفة في المستودع.
#
#    ⚠ يجب أن تكونا في .env لا .env.local — Prisma CLI لا يقرأ .env.local.
#    البذر لا يغيّر كلمة مرور حساب موجود مسبقًا؛ يؤثّر عند الإنشاء فقط.
SEED_ADMIN_PASSWORD=""
SEED_TEACHER_PASSWORD=""

# ─────────────────────────────────────────────────────────────
#  الإنتاج
# ─────────────────────────────────────────────────────────────
# عنوان الموقع. المشروع يضبط trustHost: true فيعمل بدونه،
# لكن تعيينه أدقّ خلف وكيل عكسي.
# AUTH_URL="https://lms.hisab.edu"
