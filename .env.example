# ═══════════════════════════════════════════════════════════════
#  انسخ هذا الملف إلى .env ثم عبّئ القيمتين أدناه
#  cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ١) رابط قاعدة البيانات
#
#    Neon (سحابية): انسخ الرابط من لوحة Neon واختر النسخة المباشرة
#    "Direct connection" لا "Pooled" — لأن prisma migrate يحتاج اتصالاً مباشراً.
#    الشكل:
#    postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DBNAME?sslmode=require
#
#    Docker محلي (npm run db:up):
#    postgresql://hisab:hisab_dev_password@localhost:5432/hisab?schema=public
DATABASE_URL=""

# ٢) مفتاح توقيع الجلسات — ولّده بهذا الأمر والصق الناتج بين علامتي التنصيص:
#    node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# ٣) تخزين الفيديو على Cloudflare R2
#
#    من لوحة Cloudflare ← R2 ← Manage API Tokens ← Create API Token
#    بصلاحية "Object Read & Write" على الدلو المطلوب.
#    R2_ACCOUNT_ID هو معرّف حسابك في Cloudflare (وليس معرّف الدلو).
#    هذه المتغيّرات يقرأها Next.js فقط، فيمكن وضعها في .env.local
#    (بينما DATABASE_URL يجب أن يبقى في .env لأن Prisma CLI لا يقرأ .env.local)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="hisab-media"
#    اختياري — تُبنى تلقائيًا من R2_ACCOUNT_ID إن تُركت فارغة
R2_ENDPOINT=""

# ─────────────────────────────────────────────────────────────
#  اختياري — غير مطلوب في التطوير المحلي
# ─────────────────────────────────────────────────────────────
# عنوان الموقع في الإنتاج. المشروع يضبط trustHost: true فلا حاجة له
# عادةً، لكن تعيينه أدقّ إذا كان أمام التطبيق وكيل عكسي.
# AUTH_URL="https://lms.hisab.edu"
